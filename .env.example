# Copy to .env.local and fill in. Never commit real values.

# MongoDB Atlas connection string (a replica set is required for transactions).
MONGODB_URI=mongodb+srv://USER:PASSWORD@CLUSTER.mongodb.net/make-my-marriage-dev

# At least 32 random characters. Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('base64url'))"
SESSION_SECRET=

# Canonical public origin. Used for CSRF origin checks and share links.
NEXT_PUBLIC_APP_URL=http://localhost:3000

# --- Later phases (optional for Phase 1) ---
# CRON_SECRET=
# RESEND_API_KEY=
# EMAIL_FROM="Make My Marriage <hello@example.com>"
# R2_ACCOUNT_ID=
# R2_ACCESS_KEY_ID=
# R2_SECRET_ACCESS_KEY=
# R2_BUCKET_NAME=
# GOOGLE_PLACES_API_KEY=
